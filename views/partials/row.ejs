<li>
  <details class="group" id="tool-<%= card.id %>">
    <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 [&::-webkit-details-marker]:hidden">
      <span class="h-2.5 w-2.5 shrink-0 rounded-full <%= card.badge.dot %>"></span>
      <div class="min-w-0 flex-1">
        <p class="font-medium"><%= card.name %> <span class="text-xs font-normal text-slate-500"><%= card.group %></span></p>
        <p class="truncate font-mono text-sm text-slate-600 dark:text-slate-300"><%= card.account || card.detail %></p>
      </div>
      <span class="hidden shrink-0 rounded-full px-2 py-0.5 text-xs sm:inline <%= card.badge.cls %>"><%= card.badge.label %></span>
      <span class="shrink-0 rounded-lg border px-3 py-1.5 text-sm dark:border-slate-700">
        <span class="group-open:hidden">ดู ▾</span><span class="hidden group-open:inline">ซ่อน ▴</span>
      </span>
    </summary>
    <div class="border-t bg-slate-50 px-4 py-4 dark:border-slate-800 dark:bg-slate-950/40">
      <%- include('detail', { card, csrf, repo }) %>
    </div>
  </details>
</li>
