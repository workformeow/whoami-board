<div class="space-y-4">
  <% if (card.account) { %>
  <div>
    <p class="text-sm text-slate-500 dark:text-slate-400">บัญชีที่ login อยู่</p>
    <p class="break-all font-mono text-lg"><%= card.account %></p>
  </div>
  <% } %>
  <% if (card.detail) { %>
  <p class="text-sm text-slate-600 dark:text-slate-400"><%= card.detail %></p>
  <% } %>
  <% card.envWarnings.forEach((w) => { %>
  <p class="rounded-lg bg-amber-100 p-2 text-sm text-amber-900 dark:bg-amber-900/40 dark:text-amber-100">⚠️ <%= w %></p>
  <% }) %>

  <% if (card.ok) { %>
  <div class="space-y-2 text-sm">
    <p class="font-medium">วิธี logout</p>
    <% if (card.logoutCmd) { %>
    <p class="text-slate-600 dark:text-slate-400">กดปุ่มด้านล่าง หน้านี้จะรันคำสั่งนี้ให้ (หรือรันเองใน terminal ก็ได้)</p>
    <div class="flex items-center gap-2">
      <code class="flex-1 overflow-x-auto whitespace-nowrap rounded bg-slate-100 px-2 py-1 dark:bg-slate-800"><%= card.logoutCmd %></code>
      <button type="button" data-copy="<%= card.logoutCmd %>" class="shrink-0 rounded border px-2 py-1 hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800">คัดลอก</button>
    </div>
    <form method="post" action="/logout/<%= card.id %>" data-confirm="<%= card.logoutConfirm %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>" />
      <input type="hidden" name="repo" value="<%= repo %>" />
      <button class="rounded-lg bg-red-600 px-4 py-2 font-medium text-white hover:bg-red-700">Logout <%= card.name %></button>
    </form>
    <p class="text-slate-500 dark:text-slate-400">อยากเปลี่ยนบัญชี: logout ก่อน แล้ว login ใหม่ตามขั้นตอนของเครื่องมือนี้</p>
    <% } else { %>
    <ul class="list-disc space-y-1 pl-5 text-slate-700 dark:text-slate-300">
      <% card.logoutSteps.forEach((s) => { %>
      <li><%= s %></li>
      <% }) %>
    </ul>
    <% } %>
  </div>
  <% } else { %>
  <%- include('steps', { card }) %>
  <% } %>

  <div class="space-y-1 border-t pt-3 text-sm dark:border-slate-800">
    <p class="text-slate-500 dark:text-slate-400">ตรวจเองใน terminal</p>
    <div class="flex items-center gap-2">
      <code class="flex-1 overflow-x-auto whitespace-nowrap rounded bg-slate-100 px-2 py-1 dark:bg-slate-800"><%= card.statusCmd %></code>
      <button type="button" data-copy="<%= card.statusCmd %>" class="shrink-0 rounded border px-2 py-1 hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800">คัดลอก</button>
    </div>
  </div>
</div>
