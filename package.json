{
  "name": "whoami-board",
  "version": "0.1.0",
  "private": true,
  "description": "Local page showing which CLIs are signed in and the git identity on this computer",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "start": "node server.ts",
    "dev": "node --watch server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
